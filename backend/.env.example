# ============================================================
#  竞赛辅助服务智能体 —— 环境配置示例
#  复制为 .env 后按需修改。全部配置项均有默认值，可直接启动。
# ============================================================

# ---------- 基本运行参数 ----------
APP_NAME=高校学科竞赛辅助服务智能体
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
# 允许跨域的前端地址，多个用逗号分隔；* 表示不限制
CORS_ORIGINS=*

# ---------- 数据库 ----------
# 默认使用 SQLite，开箱即用；生产环境切换为 MySQL 或 PostgreSQL
#   MySQL:      mysql+pymysql://user:password@127.0.0.1:3306/competition_agent?charset=utf8mb4
#   PostgreSQL: postgresql+psycopg://user:password@127.0.0.1:5432/competition_agent
DATABASE_URL=sqlite:///./data/competition_agent.db
SQL_ECHO=false

# ---------- 大模型 ----------
# builtin      : 内置离线智能体，无需任何密钥，检索 + 规则 + 结构化数据驱动
# deepseek     : DeepSeek 开放平台（OpenAI 兼容）
# qwen         : 阿里云百炼 / 通义千问（OpenAI 兼容）
# doubao       : 火山方舟 / 豆包（OpenAI 兼容）
# openai_compatible : 任意 OpenAI 兼容端点，需自行填写 BASE_URL 与 MODEL
LLM_PROVIDER=builtin
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ---------- 通用模型问答（所有角色可用，用户可自主选择模型） ----------
# 为需要出现在「通用模型问答」模型列表中的供应商配置独立密钥。
# 未配置密钥的模型仍会显示，但前端会禁用并提示。
# 当前主通道（LLM_PROVIDER 对应的供应商）可复用 LLM_API_KEY。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
DOUBAO_API_KEY=
DOUBAO_MODEL=
# 通用问答单次请求的上下文上限
LLM_CHAT_MAX_MESSAGES=20
LLM_CHAT_MAX_CHARS=16000

# ---------- 向量模型（用于知识库语义检索） ----------
# builtin : 离线哈希向量（字符 n-gram 哈希 TF-IDF），无外网也可用
# qwen    : 阿里云百炼 text-embedding-v3
# doubao  : 火山方舟向量模型
EMBEDDING_PROVIDER=builtin
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=512

# ---------- RAG 检索参数 ----------
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=6
RAG_RECALL_K=20
# 混合检索权重（向量 + 关键词），两者之和不为 1 时自动归一化
RAG_VECTOR_WEIGHT=0.6
RAG_KEYWORD_WEIGHT=0.4
RAG_MIN_SCORE=0.05

# ---------- 数据目录 ----------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
KNOWLEDGE_DIR=./data/knowledge
SEED_DIR=./data/seed
RULES_DIR=./data/rules
PROMPT_DIR=./prompts

# ---------- 业务默认值 ----------
DEFAULT_COLLEGE=计算与智能技术学院
DEFAULT_CURRENCY=CNY